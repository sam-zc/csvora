{
  "name": "csvora",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
